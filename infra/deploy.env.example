# =============================================================================
# Syntaxia — production env checklist (Vercel + Render + Neon)
# Copy values into each platform dashboard. Do not commit real secrets.
# =============================================================================

# --- Neon ---
# DATABASE_URL          = pooler connection string (sslmode=require)
# SANDBOX_DATABASE_URL  = direct host + user syntaxia_sandbox (sslmode=require)
# After creating the project, run:  .\scripts\db\migrate-neon.ps1

# --- Render (syntaxia-api) ---
APP_ENV=production
JWT_SECRET=
DATABASE_URL=
SANDBOX_DATABASE_URL=
CORS_ORIGINS=https://your-app.vercel.app
WEB_BASE_URL=https://your-app.vercel.app
# Optional Google (leave empty for local curriculum)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
BOOTSTRAP_ADMIN_EMAIL=
CURRICULUM_LOCAL_PATH=/app/curriculum
# PORT is set automatically by Render

# --- Vercel (Root Directory = apps/web) ---
NUXT_PUBLIC_API_BASE=https://syntaxia-api.onrender.com
