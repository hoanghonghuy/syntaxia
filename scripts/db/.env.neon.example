# Neon PostgreSQL credentials (local only — DO NOT commit)
#
# Setup:
#   copy scripts\db\.env.neon.example scripts\db\.env.neon
#   # Paste connection strings from Neon Console
#
# migrate-neon.ps1 reads this file automatically.

# App / migrate: prefer Pooler endpoint (sslmode=require)
NEON_DATABASE_URL=

# Sandbox learner queries use TEMP tables — use the Direct (non-pooler) host
# NEON_SANDBOX_DATABASE_URL=

# Strong password for role syntaxia_sandbox (set on first migrate)
# NEON_SANDBOX_PASSWORD=
