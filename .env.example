# =============================================================================
# Syntaxia — copy values into workspace `.env` (keep Synapse block above if present)
# Docker Compose reads these via ${VAR}. Host ports default: web 3001, API 8082.
# =============================================================================

# API (inside container listens on 8080; host maps SYNTAXIA_API_PORT)
API_PORT=8080
DATABASE_URL=postgres://syntaxia:syntaxia@localhost:5432/syntaxia?sslmode=disable
SANDBOX_DATABASE_URL=postgres://syntaxia_sandbox:syntaxia_sandbox@localhost:5432/syntaxia?sslmode=disable
JWT_SECRET=change-me-in-production-use-long-random-string
# Set APP_ENV=production on real hosts (API refuses dev JWT_SECRET default)
APP_ENV=
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
CURRICULUM_LOCAL_PATH=../../docs/curriculum
WEB_BASE_URL=http://localhost:3001

# Optional: first matching register/login email is promoted to admin
BOOTSTRAP_ADMIN_EMAIL=

# Google OAuth (user login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8082/api/v1/auth/google/callback

# Google Drive (service account JSON + shared folder). Empty = local curriculum.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CREDENTIALS_FILE=
# Example: GOOGLE_DRIVE_CREDENTIALS_FILE=C:/secrets/syntaxia-drive-sa.json

# Web
NUXT_PUBLIC_API_BASE=http://localhost:8082
SYNTAXIA_WEB_PORT=3001
SYNTAXIA_API_PORT=8082

# Cloud (Vercel / Render / Neon) — see infra/deploy.env.example and docs/processes/production-deploy.md
# API also accepts PORT (Render sets this automatically).
